{
  "version": "1.0",
  "profile": {
    "ProductId": "DEMO_TSL_001",
    "CategoryId": "1"
  },
  "properties": [
    {
      "id": "temperature",
      "name": "温度",
      "desc": "设备环境温度",
      "mode": "r",
      "required": true,
      "define": {
        "type": "float",
        "min": -40,
        "max": 125,
        "start": 25,
        "step": 0.1,
        "unit": "℃"
      }
    },
    {
      "id": "humidity",
      "name": "湿度",
      "desc": "设备环境湿度",
      "mode": "r",
      "required": true,
      "define": {
        "type": "float",
        "min": 0,
        "max": 100,
        "start": 50,
        "step": 0.1,
        "unit": "%RH"
      }
    },
    {
      "id": "mode",
      "name": "运行模式",
      "desc": "设备运行模式",
      "mode": "rw",
      "define": {
        "type": "enum",
        "mapping": {
          "0": "停止",
          "1": "运行",
          "2": "维护"
        }
      }
    },
    {
      "id": "reportInterval",
      "name": "上报周期",
      "desc": "设备数据上报周期",
      "mode": "rw",
      "define": {
        "type": "int",
        "min": 5,
        "max": 3600,
        "start": 60,
        "step": 1,
        "unit": "s"
      }
    },
    {
      "id": "alarmThreshold",
      "name": "告警阈值",
      "desc": "温度告警阈值",
      "mode": "rw",
      "define": {
        "type": "float",
        "min": -40,
        "max": 200,
        "start": 85,
        "step": 0.1,
        "unit": "℃"
      }
    },
    {
      "id": "relay",
      "name": "继电器",
      "desc": "继电器开关状态",
      "mode": "rw",
      "define": {
        "type": "bool"
      }
    },
    {
      "id": "deviceInfo",
      "name": "设备信息",
      "desc": "设备静态信息",
      "mode": "r",
      "define": {
        "type": "struct",
        "specs": {
          "vendor": {
            "name": "厂商",
            "type": "string"
          },
          "model": {
            "name": "型号",
            "type": "string"
          },
          "serialNumber": {
            "name": "序列号",
            "type": "string"
          }
        }
      }
    }
  ],
  "events": [
    {
      "id": "overTemperature",
      "name": "温度超限",
      "desc": "温度超过告警阈值",
      "type": "alert",
      "params": [
        {
          "id": "temperature",
          "name": "当前温度",
          "define": {
            "type": "float",
            "min": -40,
            "max": 200,
            "unit": "℃"
          }
        },
        {
          "id": "threshold",
          "name": "告警阈值",
          "define": {
            "type": "float",
            "min": -40,
            "max": 200,
            "unit": "℃"
          }
        }
      ]
    },
    {
      "id": "deviceFault",
      "name": "设备故障",
      "desc": "设备产生故障",
      "type": "fault",
      "params": [
        {
          "id": "code",
          "name": "故障码",
          "define": {
            "type": "string"
          }
        },
        {
          "id": "message",
          "name": "故障描述",
          "define": {
            "type": "string"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "setMode",
      "name": "设置运行模式",
      "desc": "设置设备运行模式",
      "input": [
        {
          "id": "mode",
          "name": "目标模式",
          "define": {
            "type": "int",
            "min": 0,
            "max": 2
          }
        }
      ],
      "output": [
        {
          "id": "success",
          "name": "是否成功",
          "define": {
            "type": "bool"
          }
        }
      ]
    },
    {
      "id": "setRelay",
      "name": "设置继电器",
      "desc": "打开或关闭继电器",
      "input": [
        {
          "id": "on",
          "name": "开关状态",
          "define": {
            "type": "bool"
          }
        }
      ],
      "output": [
        {
          "id": "success",
          "name": "是否成功",
          "define": {
            "type": "bool"
          }
        }
      ]
    },
    {
      "id": "applyConfig",
      "name": "应用配置",
      "desc": "应用设备上报周期",
      "input": [
        {
          "id": "reportInterval",
          "name": "上报周期",
          "define": {
            "type": "int",
            "min": 5,
            "max": 3600,
            "unit": "s"
          }
        }
      ],
      "output": [
        {
          "id": "success",
          "name": "是否成功",
          "define": {
            "type": "bool"
          }
        }
      ]
    }
  ]
}
